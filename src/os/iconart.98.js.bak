const cache = new Map();

/**
 * Render one icon map to a data URL at the given pixel scale.
 * Cached, so the same icon at the same size is only drawn once.
 */
export function iconUrl(name, scale = 2) {
  const key = name + "@" + scale;
  if (cache.has(key)) return cache.get(key);

  const map = iconMaps[name];
  if (!map) return "";

  const colours = INK;
  const size = map.length;
  const canvas = document.createElement("canvas");
  canvas.width = size * scale;
  canvas.height = size * scale;
  const ctx = canvas.getContext("2d");
  ctx.imageSmoothingEnabled = false;

  for (let y = 0; y < size; y++) {
    const row = map[y];
    for (let x = 0; x < row.length; x++) {
      const ch = row[x];
      if (ch === "." || !colours[ch]) continue;
      ctx.fillStyle = colours[ch];
      ctx.fillRect(x * scale, y * scale, scale, scale);
    }
  }

  const url = canvas.toDataURL();
  cache.set(key, url);
  return url;
}

/** An <img> element for an icon, ready to drop into the DOM. */
export function iconImg(name, scale = 2, alt = "") {
  const img = document.createElement("img");
  img.src = iconUrl(name, scale);
  img.alt = alt;
  img.className = "pixel-icon";
  img.draggable = false;
  return img;
}
