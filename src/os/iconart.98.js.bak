// =====================================================================
//  ICON ART — 16x16 pixel icons drawn from letter maps, the same
//  technique the platformer résumé uses for its sprites.
//
//  Each row is a string. Each letter is one pixel. "." is transparent.
//  Change a letter, get a different icon. No image files involved.
// =====================================================================

import { brand } from "../../config/theme.js";

// Letter -> colour, from the fixed 16-colour VGA palette Windows icons
// were drawn in. These do NOT follow the colour scheme: Windows never
// recoloured its icons when you changed the appearance scheme, and if
// they did follow it, every cached icon would go stale on every switch.
const INK = {
  K: "#000000",  // outline black
  W: "#FFFFFF",  // white
  L: "#C0C0C0",  // light grey (the fixed icon grey, not the chrome grey)
  G: "#808080",  // mid grey
  D: "#404040",  // dark grey
  R: brand.logo,      // the brand red, fixed like the logo
  A: brand.logoDark,
  Y: "#FFFF00",  // folder yellow
  O: "#808000",  // folder shadow
  B: "#0000A8",  // blue
  C: "#00FFFF",  // cyan screen
  E: "#008000",  // green
  T: "#008080",  // teal
  S: "#D9A066",  // skin
  P: "#800080"   // purple
};

