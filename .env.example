# Copy this file to .env.local and fill in ONE key. Never commit .env.local —
# it is already in .gitignore.
#
# The assistant works with no key at all: search runs, and it quotes his own
# notes instead of writing an answer. A key upgrades those quotes into real
# answers. It does not need to be a paid one.
#
# The server uses whichever key it finds, checking in the order below, so
# adding a better key later needs no code change.


# ---------------------------------------------------------------------------
#  RECOMMENDED — one free key covers BOTH answers and semantic search
# ---------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
# Free tier, no card required, works from India.
# This single key powers the chat answers AND the embeddings, so it is the
# only one you need.
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
#  OTHER FREE OPTIONS — any one of these works instead
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys
# Free tier, no card. Very fast, which suits a chat window.
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# Models whose id ends in ":free" cost nothing. Change the model in
# api/_providers.js to pick a different one.
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=


# ---------------------------------------------------------------------------
#  PAID — better quality, only if the budget is there
# ---------------------------------------------------------------------------
# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
#  EMBEDDINGS — only needed if you are NOT using GEMINI_API_KEY above
# ---------------------------------------------------------------------------
# Semantic search matches meaning rather than words, so "is he any good with
# Google?" finds the SEO sections. Without it, search is keyword-only, which
# works but misses paraphrased questions.
#
# GEMINI_API_KEY already covers this. These are alternatives.

# Jina AI — https://jina.ai/embeddings  (free tier)
JINA_API_KEY=

# Voyage AI — https://dash.voyageai.com  (free tier)
VOYAGE_API_KEY=
